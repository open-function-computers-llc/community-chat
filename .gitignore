# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Runtime data — never commit the DB or uploads
backend/data/
backend/uploads/
# The SQLite DB lives at the project root under ./data (bind-mounted into the
# container at /app/data). Ignore the dir and its WAL/journal side files.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
# Uploaded files (avatars, attachments) live at the project root under
# ./uploads (bind-mounted into the container at /app/uploads).
uploads/
# Mailpit (local dev email sink) captures — never commit.
mailpit/

# Frontend
frontend/node_modules/
frontend/dist/

# Env / secrets
.env
.env.*
!.env.example

# Catch any other local SQLite residue
*.sqlite3

# OS / editor
.DS_Store
.idea/
