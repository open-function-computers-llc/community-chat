# Copy this file to `.env` and adjust values. docker compose reads `.env`.

# Port the app listens on (host and container). Default 8983.
PORT=8983

# JWT signing key. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Seeded admin account, created on first boot only.
ADMIN_HANDLE=admin
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Web Push (VAPID) — push notifications. Generate a keypair (see README) and
# put the PRIVATE key here; the PUBLIC key is used by the frontend. Optional:
# without these, push notifications are disabled (the app still works).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@example.com

# Public origin of the site (deep links / VAPID audience). In production set
# this to your domain, e.g. https://whimsy-chat.openfunction.website.
APP_ORIGIN=

# ---------------------------------------------------------------------------
# Transactional email (SMTP). Sent via a provider (Resend, Mailgun, ...).
# Local dev: the docker-compose stack runs a Mailpit sink and .env points
# SMTP_HOST=mailpit (port 1025); emails appear at http://localhost:3025.
#
# Production example (Resend):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=<your Resend SMTP API key>
#   SMTP_FROM_ADDRESS=noreply@your-domain
#   SMTP_FROM_NAME=Your App
# Leave SMTP_HOST empty to disable email entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Community Chat
